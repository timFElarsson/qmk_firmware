{
    "keyboard_name": "banzai",
    "maintainer": "timFElarsson",
    "manufacturer": "Tim Larsson",
    "url": "https://github.com/timFElarsson",

    "bootloader": "rp2040",
    "processor": "RP2040",

    "split": {
        "transport": {
            "protocol": "serial"
        }
    },

    "matrix_pins": {
        "direct": [
            ["GP22", null,   null,   null,   null,   null],
            ["GP8", "GP9", "GP26", "GP27", "GP28", "GP29"],
            ["GP6", "GP7", "GP13", "GP15", "GP21", "GP20"],
            ["GP4", "GP5", "GP12", "GP14", "GP16", "GP23"],
            ["GP3", "GP1", "GP0",    null,   null,   null]
        ]
    },
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x1212",
        "vid": "0x1987"
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0],  "x": 0,  "y": 0,    "label": "Escape"},
                {"matrix": [5, 0],  "x": 11, "y": 0,    "label": "Enter"},

                {"matrix": [1, 0],  "x": 0,  "y": 1,    "label": "Tab"},
                {"matrix": [1, 1],  "x": 1,  "y": 1,    "label": "Q"},
                {"matrix": [1, 2],  "x": 2,  "y": 1,    "label": "W"},
                {"matrix": [1, 3],  "x": 3,  "y": 1,    "label": "E"},
                {"matrix": [1, 4],  "x": 4,  "y": 1,    "label": "R"},
                {"matrix": [1, 5],  "x": 5,  "y": 1,    "label": "T"},

                {"matrix": [6, 5],  "x": 6,  "y": 1,    "label": "Y"},
                {"matrix": [6, 4],  "x": 7,  "y": 1,    "label": "U"},
                {"matrix": [6, 3],  "x": 8,  "y": 1,    "label": "I"},
                {"matrix": [6, 2],  "x": 9,  "y": 1,    "label": "O"},
                {"matrix": [6, 1],  "x": 10, "y": 1,    "label": "P"},
                {"matrix": [6, 0],  "x": 11, "y": 1,    "label": "Å"},

                {"matrix": [2, 0],  "x": 0,  "y": 2,    "label": "Left Shift"},
                {"matrix": [2, 1],  "x": 1,  "y": 2,    "label": "A"},
                {"matrix": [2, 2],  "x": 2,  "y": 2,    "label": "S"},
                {"matrix": [2, 3],  "x": 3,  "y": 2,    "label": "D"},
                {"matrix": [2, 4],  "x": 4,  "y": 2,    "label": "F"},
                {"matrix": [2, 5],  "x": 5,  "y": 2,    "label": "G"},

                {"matrix": [7, 5],  "x": 6,  "y": 2,    "label": "H"},
                {"matrix": [7, 4],  "x": 7,  "y": 2,    "label": "J"},
                {"matrix": [7, 3],  "x": 8,  "y": 2,    "label": "K"},
                {"matrix": [7, 2],  "x": 9,  "y": 2,    "label": "L"},
                {"matrix": [7, 1],  "x": 10, "y": 2,    "label": "Ö"},
                {"matrix": [7, 0],  "x": 11, "y": 2,    "label": "Ä"},

                {"matrix": [3, 0],  "x": 0,  "y": 3,    "label": "Left Ctrl"},
                {"matrix": [3, 1],  "x": 1,  "y": 3,    "label": "Z"},
                {"matrix": [3, 2],  "x": 2,  "y": 3,    "label": "X"},
                {"matrix": [3, 3],  "x": 3,  "y": 3,    "label": "C"},
                {"matrix": [3, 4],  "x": 4,  "y": 3,    "label": "V"},
                {"matrix": [3, 5],  "x": 5,  "y": 3,    "label": "B"},

                {"matrix": [8, 5],  "x": 6,  "y": 3,    "label": "N"},
                {"matrix": [8, 4],  "x": 7,  "y": 3,    "label": "M"},
                {"matrix": [8, 3],  "x": 8,  "y": 3,    "label": "Comma"},
                {"matrix": [8, 2],  "x": 9,  "y": 3,    "label": "Dot"},
                {"matrix": [8, 1],  "x": 10, "y": 3,    "label": "Minus"},
                {"matrix": [8, 0],  "x": 11, "y": 3,    "label": "Single Quote"},

                {"matrix": [4, 0],  "x": 3,  "y": 4,    "label": "Left Alt"},
                {"matrix": [4, 1],  "x": 4,  "y": 4,    "label": "Left GUI"},
                {"matrix": [4, 2],  "x": 5,  "y": 4,    "label": "Raise Layer"},

                {"matrix": [9, 2],  "x": 6,  "y": 4,    "label": "Space"},
                {"matrix": [9, 1],  "x": 7,  "y": 4,    "label": "Lower Layer"},
                {"matrix": [9, 0],  "x": 8,  "y": 4,    "label": "Code Layer"}
            ]
        }
